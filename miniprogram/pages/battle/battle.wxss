/* 战斗页样式 */
.wrap { padding: 20rpx 24rpx 60rpx; }
.status {
  background: #0e131d; border: 1rpx solid #1e2836; border-radius: 14rpx;
  padding: 20rpx 24rpx; margin-bottom: 20rpx;
}
.hearts { font-size: 34rpx; letter-spacing: 6rpx; }
.hearts .lost { opacity: .25; }
.srow { display: flex; align-items: center; gap: 10rpx; margin-top: 10rpx; font-size: 22rpx; flex-wrap: wrap; }
.srow .dim { color: #8b9bb4; }
.srow .v { color: #dbe4f0; font-size: 26rpx; margin-right: 10rpx; }
.srow .amber { color: #fbbf24; }
.srow .cyan { color: #22d3ee; }
.items { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 14rpx; }
.chip {
  font-size: 21rpx; border: 1rpx solid #1e2836; background: #121926;
  color: #dbe4f0; border-radius: 8rpx; padding: 6rpx 16rpx;
}
.chip.off { opacity: .35; }

.battle {
  background: #0e131d; border: 1rpx solid #2a3548; border-radius: 22rpx;
  padding: 28rpx 28rpx 26rpx; margin-bottom: 20rpx;
}
.battle.boss { border-color: rgba(251,191,36,.55); }
.battle.elite { border-color: rgba(167,139,250,.5); }
.battle.shadowc { border-color: rgba(248,113,113,.55); }

.timerbar { height: 10rpx; background: #1a2230; border-radius: 6rpx; overflow: hidden; margin-bottom: 18rpx; }
.timerbar .ti { height: 100%; background: #a78bfa; border-radius: 6rpx; }
.timerbar.danger .ti { background: #f87171; }

.b-head { display: flex; flex-wrap: wrap; gap: 10rpx; margin-bottom: 16rpx; }
.chip2 {
  font-size: 20rpx; color: #8b9bb4; border: 1rpx solid #1e2836;
  border-radius: 8rpx; padding: 4rpx 14rpx; background: #121926;
}
.chip2.f { color: #22d3ee; border-color: #22d3ee; }
.chip2.elite { color: #a78bfa; border-color: #a78bfa; }
.chip2.bossc { color: #fbbf24; border-color: #fbbf24; }
.chip2.shadowc { color: #f87171; border-color: #f87171; }

.qtext { font-size: 30rpx; font-weight: 600; line-height: 1.75; margin-bottom: 20rpx; }
.qtext.sm { font-size: 26rpx; font-weight: 500; }

.opts { display: flex; flex-direction: column; gap: 14rpx; }
.opt {
  display: flex; gap: 16rpx; background: #121926; border: 1rpx solid #1e2836;
  border-radius: 14rpx; padding: 20rpx 22rpx; font-size: 26rpx; line-height: 1.6;
}
.opt:active { border-color: #22d3ee; }
.opt .ol { color: #8b9bb4; font-weight: 700; }
.opt.right { border-color: #34d399; background: rgba(52,211,153,.12); }
.opt.wrongpick { border-color: #f87171; background: rgba(248,113,113,.1); }
.opt.zapped { opacity: .25; text-decoration: line-through; }

.hintline {
  margin-top: 18rpx; font-size: 24rpx; color: #fbbf24;
  border: 1rpx dashed rgba(251,191,36,.5); background: rgba(251,191,36,.05);
  border-radius: 10rpx; padding: 12rpx 18rpx;
}

.verdict { border-radius: 14rpx; padding: 20rpx 22rpx; margin-top: 22rpx; font-size: 25rpx; line-height: 1.75; }
.verdict.good { background: rgba(52,211,153,.09); border: 1rpx solid rgba(52,211,153,.45); }
.verdict.bad { background: rgba(248,113,113,.09); border: 1rpx solid rgba(248,113,113,.45); }
.v-tag { font-size: 20rpx; letter-spacing: 3rpx; margin-bottom: 8rpx; color: #34d399; }
.verdict.bad .v-tag { color: #f87171; }
.v-ans { font-size: 22rpx; color: #a78bfa; margin-bottom: 6rpx; }
.v-body { color: #dbe4f0; }
.nb { width: 100% !important; }
.rb { width: 100% !important; margin-left: 0 !important; }

.shopgrid { display: flex; flex-wrap: wrap; gap: 14rpx; margin: 16rpx 0 8rpx; }
.shopitem {
  width: calc(50% - 7rpx); box-sizing: border-box; background: #121926;
  border: 1rpx solid #1e2836; border-radius: 14rpx; padding: 20rpx;
}
.shopitem.off { opacity: .4; }
.shopitem:active { border-color: #fbbf24; }
.sn { font-weight: 700; font-size: 27rpx; }
.sd { color: #8b9bb4; font-size: 21rpx; margin: 6rpx 0; }
.sc { color: #fbbf24; font-size: 22rpx; }

.rgrid { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 18rpx 0; }
.rcell {
  width: calc(25% - 9rpx); box-sizing: border-box; background: #121926;
  border: 1rpx solid #1e2836; border-radius: 12rpx; padding: 14rpx 0; text-align: center;
}
.rv { font-size: 34rpx; font-weight: 800; color: #22d3ee; }
.rk { font-size: 19rpx; color: #8b9bb4; margin-top: 2rpx; }
.mrow { display: flex; align-items: center; gap: 12rpx; margin: 10rpx 0; font-size: 20rpx; color: #8b9bb4; }
.mn { width: 190rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.mbar { flex: 1; height: 12rpx; background: #1a2230; border-radius: 6rpx; overflow: hidden; }
.mbi { height: 100%; border-radius: 6rpx; }
.mv { width: 70rpx; text-align: right; color: #dbe4f0; }
.ranktip {
  margin-top: 16rpx; font-size: 24rpx; color: #8b9bb4;
  border: 1rpx dashed rgba(251,191,36,.5); border-radius: 12rpx; padding: 14rpx 18rpx;
}

.floors {
  background: #0e131d; border: 1rpx solid #1e2836; border-radius: 14rpx;
  padding: 20rpx 24rpx;
}
.flr { display: flex; align-items: center; gap: 14rpx; font-size: 22rpx; color: #8b9bb4; padding: 4rpx 0; }
.dot {
  width: 44rpx; height: 44rpx; border-radius: 10rpx; border: 1rpx solid #1e2836;
  display: flex; align-items: center; justify-content: center; font-size: 20rpx;
}
.flr.done .dot { background: rgba(52,211,153,.15); border-color: #34d399; color: #34d399; }
.flr.now .dot { background: rgba(34,211,238,.18); border-color: #22d3ee; color: #22d3ee; }
.flr.now { color: #dbe4f0; }
.shadow-note { margin-top: 12rpx; font-size: 20rpx; color: #f87171; }

/* 答案解析 */
.v-exp{margin-top:8px;padding:8px 12px;border-radius:7px;font-size:12.5px;line-height:1.75;background:rgba(34,211,238,.06);border:1px solid rgba(34,211,238,.35)}
.verdict.bad .v-exp{background:rgba(251,191,36,.08);border-color:rgba(251,191,36,.6)}
/* 逐选项解析（错在哪） */
.v-dexp{margin-top:10rpx;display:flex;flex-direction:column;gap:6rpx}
.v-dexp .dopt{font-size:22rpx;line-height:1.6;color:#e08e84;padding:8rpx 14rpx;background:rgba(239,68,68,.06);border-left:4rpx solid rgba(239,68,68,.45);border-radius:0 8rpx 8rpx 0}
.v-dexp .dopt.ok{color:#86efac;background:rgba(52,211,153,.07);border-left-color:rgba(52,211,153,.5)}
.v-dexp .dl{margin-right:12rpx;color:#ef4444;font-weight:700}
.v-dexp .dopt.ok .dl{color:#34d399}
