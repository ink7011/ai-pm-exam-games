<view class="wrap">
  <view class="head">
    <view class="t1 mono">TOWER SELECT</view>
    <view class="t2">选择试炼塔</view>
    <view class="weak" wx:if="{{weak}}">🎯 弱点侦察：最薄弱的是「{{weak.tower}}」（正确率 {{weak.acc}}%，样本 {{weak.total}}）——建议优先攻克</view>
  </view>

  <block wx:for="{{groups}}" wx:for-item="g" wx:key="key">
    <view class="g-head mono">▸ {{g.label}} · {{g.en}}</view>
    <view class="tgrid">
      <view class="tower {{item.locked ? 'locked' : ''}}" wx:for="{{g.towers}}" wx:key="id" data-id="{{item.id}}" bindtap="pick">
        <view class="tn">{{item.name}}</view>
        <view class="td mono">{{item.desc}} · {{item.n}} 题</view>
        <view class="best mono" wx:if="{{item.best}}">最佳 {{item.best}} 分</view>
        <view class="lock mono" wx:if="{{item.locked}}">🔒 解锁 ¥{{item.price}}</view>
      </view>
    </view>
  </block>
</view>
